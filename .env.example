# Token do estabelecimento (Configurações → Integrações → API).
# Não commite o valor real. Copie este arquivo para .env.local.
CARDAPIO_WEB_TOKEN=

# Não fica no painel da loja. É a chave de uma integradora de software,
# pedida em integracao@cardapioweb.com. O token da loja já lê catálogo e dados
# do estabelecimento, então este campo pode ficar vazio.
CARDAPIO_WEB_PARTNER_KEY=

# api-key (padrão) ou bearer, se o token for OAuth.
CARDAPIO_WEB_AUTH=api-key

# Código público da loja. Vira o link https://app.cardapioweb.com/SEU_CODIGO
NEXT_PUBLIC_CARDAPIO_WEB_STORE_CODE=

# Opcional. Se a loja tiver domínio próprio, use ele no lugar do link acima.
NEXT_PUBLIC_CARDAPIO_WEB_MENU_URL=

# Link para avaliar no Google (perfil da loja no Maps).
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# Chave da Places API (New). Só no servidor: não use o prefixo NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# Place ID da loja, o texto que começa com ChIJ no localizador do Google.
GOOGLE_PLACE_ID=
